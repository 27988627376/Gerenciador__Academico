@using GerenciadorAcademico.ViewModels

@model GerenciadorAcademico.ViewModels.EditarProjetoViewModel

@{
    ViewData["Title"] = "Editar projeto";
}

<h1>Editar projeto</h1>

<form asp-action="Editar" method="post">

    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="ModelOnly"></div>

    <partial name="_FormularioProjeto"
             model="(ProjetoFormularioViewModel)Model" />

    <button type="submit" class="button"> Salvar alterações</button>
    <a asp-action="Index" class="button secondary">Voltar</a>

</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}