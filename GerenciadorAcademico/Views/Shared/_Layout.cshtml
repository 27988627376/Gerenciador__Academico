<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GerenciadorAcademico</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GerenciadorAcademico.styles.css" asp-append-version="true" />
</head>
<body>
    <header>


        <nav class="nav">
            <a href="">GERENCIADOR ACADEMICO</a>
            <a class="brand" asp-controller ="" asp-action=""></a>
           <a asp-controller ="Projetos" asp-action="Index">Home</a>
            <a  asp-controller="Projetos" asp-action="Cadastrar">Cadastrar Usuario</a>
        </nav>
    </header>



    <div class="container">
        <main class="container">
            @RenderBody()
        </main>
        @await RenderSectionAsync("Scripts", required: false)
        </div>
</body>
</html>
